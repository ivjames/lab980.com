#!/usr/bin/env bash
# node22-bump — the deterministic half of the droplet-wide Node 20 -> 22 bump.
#
# What this does NOT do (manual, environment-specific — see runbook in
# CLAUDE.md / below): install Node 22 or (re)install the pm2 boot hook. Do those
# by hand, THEN run this. It refuses to run unless `node` is already v22.
#
# What it DOES, once Node 22 is active:
#   1. reinstall pm2 globally under Node 22 (its native pieces + daemon)
#   2. per /var/www/* site: recompile native modules against Node 22's ABI
#      (Node 20 = MODULE_VERSION 115, Node 22 = 127 — old *.node won't load, so
#      this MUST happen before processes restart). Missing node_modules -> npm ci.
#   3. only if every site's rebuild succeeded (or --force): `pm2 update` to
#      respawn the daemon under Node 22 and restart all apps, then `pm2 save`.
#   4. report pm2 status and flag anything not "online".
#
# Order matters: rebuild every site FIRST, restart AFTER — otherwise a native
# app restarts under 22 against a 20-compiled binary and crash-loops.
#
# Usage:
#   node22-bump --dry-run        # print the plan, touch nothing
#   node22-bump                  # rebuild all sites, then restart if clean
#   node22-bump --no-restart     # rebuild only; restart yourself later
#   node22-bump --force          # restart even if some site failed to rebuild
#   node22-bump --clean          # full `npm ci` per site instead of `npm rebuild`
set -uo pipefail

DRY=0; DO_RESTART=1; FORCE=0; CLEAN=0
DIRS=()

c_blue=$'\033[1;34m'; c_green=$'\033[1;32m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
run()  { if [ "$DRY" -eq 1 ]; then printf '  [dry-run] %s\n' "$*"; else eval "$*"; fi; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)    DRY=1; shift;;
    --no-restart) DO_RESTART=0; shift;;
    --force)      FORCE=1; shift;;
    --clean)      CLEAN=1; shift;;
    -h|--help)    sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    -*)           die "unknown option: $1 (see --help)";;
    *)            DIRS+=("$1"); shift;;
  esac
done

[ "$(id -u)" -eq 0 ] || die "run as root."

# ---- guard: Node 22 must already be the active runtime ----
node_major="$(node --version 2>/dev/null | sed -E 's/^v([0-9]+)\..*/\1/')"
[ -n "$node_major" ] || die "node not found on PATH."
if [ "$node_major" != "22" ]; then
  die "active node is $(node --version) — install/activate Node 22 FIRST, then re-run.
       (nodesource: 'curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs';
        or via n: 'n 22'; or nvm: 'nvm install 22 && nvm alias default 22')"
fi
log "active node: $(node --version), npm $(npm --version)"

# Default target set: every immediate /var/www/* dir with a package.json.
if [ "${#DIRS[@]}" -eq 0 ]; then
  for d in /var/www/*/; do [ -f "${d%/}/package.json" ] && DIRS+=("${d%/}"); done
fi
[ "${#DIRS[@]}" -gt 0 ] || die "no Node sites found under /var/www."

# ---- 1. pm2 under Node 22 ----
log "reinstalling pm2 globally under Node 22"
run "npm install -g pm2"

# ---- 2. recompile native modules per site ----
log "rebuilding ${#DIRS[@]} site(s) against the Node 22 ABI"
declare -A RESULT
fails=0
for dir in "${DIRS[@]}"; do
  name="$(basename "$dir")"
  logf="/tmp/n22-bump-${name}.log"
  if [ ! -d "$dir/node_modules" ] || [ "$CLEAN" -eq 1 ]; then
    action="npm ci"
  else
    action="npm rebuild"
  fi
  log "[$name] $action"
  if [ "$DRY" -eq 1 ]; then
    printf '  [dry-run] (cd %s && %s)\n' "$dir" "$action"
    RESULT[$name]="dry-run"
    continue
  fi
  if ( cd "$dir" && $action ) >"$logf" 2>&1; then
    RESULT[$name]="ok"
  else
    RESULT[$name]="FAIL ($logf)"
    fails=$((fails+1))
  fi
done

echo
log "rebuild summary"
for name in "${!RESULT[@]}"; do
  r="${RESULT[$name]}"; color="$c_green"; [ "$r" = ok ] || color="$c_yellow"
  case "$r" in FAIL*) color="$c_red";; esac
  printf '  %-22s %s%s%s\n' "$name" "$color" "$r" "$c_off"
done | sort
echo

# ---- 3. restart, gated on a clean rebuild ----
if [ "$DO_RESTART" -eq 0 ]; then
  log "rebuild done; skipping restart (--no-restart). Restart later with: pm2 update && pm2 save"
  exit 0
fi
if [ "$fails" -gt 0 ] && [ "$FORCE" -eq 0 ]; then
  die "$fails site(s) failed to rebuild — NOT restarting (their processes would crash-loop under 22).
       Inspect /tmp/n22-bump-<site>.log, fix, and re-run. Override with --force to restart anyway."
fi
log "restarting the pm2 daemon + all apps under Node 22 (pm2 update)"
run "pm2 update"
run "pm2 save"

# ---- 4. verify ----
if [ "$DRY" -eq 0 ]; then
  echo; log "pm2 status"; pm2 status
  errored="$(pm2 jlist 2>/dev/null | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{const a=JSON.parse(d);const bad=a.filter(p=>p.pm2_env&&p.pm2_env.status!=="online").map(p=>p.name);process.stdout.write(bad.join(","))}catch(e){}})' 2>/dev/null)"
  if [ -n "$errored" ]; then
    warn "not online after restart: $errored — check 'pm2 logs <name>'."
  else
    log "all pm2 processes online under Node 22."
  fi
fi

cat <<DONE

${c_blue}==>${c_off} Node 22 bump sweep complete.
Post-bump checklist (manual):
  - confirm the boot hook still points at the new node:
      systemctl is-enabled pm2-root        # -> enabled
      pm2 startup systemd -u root --hp /root   # re-run + paste its line if the node path changed
  - spot-check a couple of sites' health endpoints (e.g. curl -s https://prm.lab980.com/api/readyz)
DONE
