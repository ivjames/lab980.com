#!/usr/bin/env bash
# node22-audit — assess each lab980 site's readiness for a Node 20 -> 22 bump.
#
# Read-only and non-disruptive: it never touches the running pm2 processes or a
# site's real node_modules. For each site it reports:
#   - the declared engines.node range (if any)
#   - native / compiled dependencies (*.node) that will need a rebuild on 22
#   - a clean-build test in a THROWAWAY copy under Node 22, if a Node 22 binary
#     is available (this is the signal that actually matters)
#
# The build test copies the repo (excluding node_modules/dist/.git) to a temp
# dir and runs `npm ci` + `npm run build` there with Node 22 on PATH, so the
# live site — its node_modules, its running process — is untouched.
#
# Usage:
#   node22-audit                         # audit every /var/www/* site
#   node22-audit /var/www/prm /var/www/gigit
#   node22-audit --node22 /path/to/node22/bin/node
#   node22-audit --fetch-node22          # download Node 22 to /tmp, then audit
#   node22-audit --no-build              # static audit only (no build test)
#   NODE22_VERSION=v22.11.0 node22-audit --fetch-node22
set -uo pipefail

FETCH=0
DO_BUILD=1
NODE22=""
NODE22_VERSION="${NODE22_VERSION:-v22.11.0}"
DIRS=()

c_blue=$'\033[1;34m'; c_green=$'\033[1;32m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --node22)       NODE22="$2"; shift 2;;
    --fetch-node22) FETCH=1; shift;;
    --no-build)     DO_BUILD=0; shift;;
    -h|--help)      usage; exit 0;;
    -*)             die "unknown option: $1 (see --help)";;
    *)              DIRS+=("$1"); shift;;
  esac
done

# Default target set: every immediate /var/www/* directory.
if [ "${#DIRS[@]}" -eq 0 ]; then
  for d in /var/www/*/; do [ -d "$d" ] && DIRS+=("${d%/}"); done
fi
[ "${#DIRS[@]}" -gt 0 ] || die "no site directories to audit."

# A node (any version) for reading package.json JSON. Prefer the box's node.
JSON_NODE="$(command -v node || true)"

# ---- resolve a Node 22 binary for the build test ----
node_major() { "$1" --version 2>/dev/null | sed -E 's/^v([0-9]+)\..*/\1/'; }

if [ "$DO_BUILD" -eq 1 ] && [ -z "$NODE22" ]; then
  # Already on PATH as node22, or the default node happens to be v22?
  if command -v node22 >/dev/null; then
    NODE22="$(command -v node22)"
  elif [ -n "$JSON_NODE" ] && [ "$(node_major "$JSON_NODE")" = "22" ]; then
    NODE22="$JSON_NODE"
  fi
fi

if [ "$DO_BUILD" -eq 1 ] && [ -z "$NODE22" ] && [ "$FETCH" -eq 1 ]; then
  arch="$(uname -m)"; case "$arch" in x86_64) narch=x64;; aarch64|arm64) narch=arm64;; *) die "unsupported arch $arch for --fetch-node22";; esac
  tarball="node-${NODE22_VERSION}-linux-${narch}"
  dest="/tmp/$tarball"
  if [ ! -x "$dest/bin/node" ]; then
    log "fetching Node ${NODE22_VERSION} ($narch) to /tmp"
    curl -fsSL "https://nodejs.org/dist/${NODE22_VERSION}/${tarball}.tar.xz" -o "/tmp/${tarball}.tar.xz" \
      || die "download failed"
    tar -xJf "/tmp/${tarball}.tar.xz" -C /tmp
  fi
  NODE22="$dest/bin/node"
fi

if [ "$DO_BUILD" -eq 1 ] && [ -z "$NODE22" ]; then
  warn "no Node 22 binary found — running STATIC audit only."
  warn "  pass --node22 <path>, or --fetch-node22 to download one."
  DO_BUILD=0
fi

if [ "$DO_BUILD" -eq 1 ]; then
  [ -x "$NODE22" ] || die "node22 binary not executable: $NODE22"
  [ "$(node_major "$NODE22")" = "22" ] || die "$NODE22 is not v22 (got $("$NODE22" --version))"
  NODE22_BIN="$(cd "$(dirname "$NODE22")" && pwd)"
  log "build tests use: $NODE22 ($("$NODE22" --version))"
fi

# ---- helpers ----
pkg_field() { # $1 dir, $2 JS expression on `p` (the parsed package.json)
  [ -n "$JSON_NODE" ] || { echo ""; return; }
  "$JSON_NODE" -e '
    try { const p=require(process.argv[1]+"/package.json"); let v=(()=>{'"$2"'})(); console.log(v==null?"":v); }
    catch(e){ console.log(""); }
  ' "$1" 2>/dev/null
}

RESULTS=()   # "name|engines|native|build"

for dir in "${DIRS[@]}"; do
  name="$(basename "$dir")"
  if [ ! -f "$dir/package.json" ]; then
    RESULTS+=("$name|—|—|n/a (no package.json)")
    continue
  fi

  engines="$(pkg_field "$dir" 'return p.engines&&p.engines.node')"
  [ -n "$engines" ] || engines="unset"

  # Native modules currently compiled (against Node 20) — these need a rebuild
  # on 22 (usually just `npm rebuild`, but flag them so it's not a surprise).
  native="none"
  if [ -d "$dir/node_modules" ]; then
    nlist="$(find "$dir/node_modules" -maxdepth 4 -type f -name '*.node' -path '*/build/Release/*' 2>/dev/null \
             | sed -E 's#.*/node_modules/(@[^/]+/[^/]+|[^/]+)/.*#\1#' | sort -u | tr '\n' ',' | sed 's/,$//')"
    [ -n "$nlist" ] && native="$nlist"
  else
    native="? (node_modules not installed)"
  fi

  # ---- clean-build test under Node 22 ----
  build="skipped"
  if [ "$DO_BUILD" -eq 1 ]; then
    has_build="$(pkg_field "$dir" 'return p.scripts&&p.scripts.build?1:""')"
    tmp="$(mktemp -d "/tmp/n22-${name}.XXXXXX")"
    # copy source only; never the live node_modules/dist
    if command -v rsync >/dev/null; then
      rsync -a --exclude=node_modules --exclude=dist --exclude=.git "$dir/" "$tmp/" >/dev/null 2>&1
    else
      cp -a "$dir/." "$tmp/" && rm -rf "$tmp/node_modules" "$tmp/dist" "$tmp/.git"
    fi
    log "[$name] building under Node 22 ..."
    (
      cd "$tmp" || exit 90
      export PATH="$NODE22_BIN:$PATH"
      if [ -f package-lock.json ]; then npm ci; else npm install; fi || exit 91
      if [ -n "$has_build" ]; then npm run build || exit 92; fi
    ) >"$tmp/.audit.log" 2>&1
    rc=$?
    case $rc in
      0)  build="PASS$([ -n "$has_build" ] || echo ' (no build script; install only)')";;
      91) build="FAIL: npm ci/install (see $tmp/.audit.log)";;
      92) build="FAIL: npm run build (see $tmp/.audit.log)";;
      *)  build="FAIL: rc=$rc (see $tmp/.audit.log)";;
    esac
    # keep the log on failure, clean the copy either way
    if [ "$rc" -eq 0 ]; then rm -rf "$tmp"; else cp "$tmp/.audit.log" "/tmp/n22-${name}.log" 2>/dev/null; rm -rf "$tmp"; build="${build/$tmp/\/tmp\/n22-${name}.log}"; fi
  fi

  RESULTS+=("$name|$engines|$native|$build")
done

# ---- report ----
printf '\n%s==> Node 22 readiness — %s site(s)%s\n\n' "$c_blue" "${#RESULTS[@]}" "$c_off"
printf '%-20s %-16s %-28s %s\n' "SITE" "engines.node" "native deps" "build @ node22"
printf '%-20s %-16s %-28s %s\n' "--------------------" "----------------" "----------------------------" "--------------------"
fails=0
for row in "${RESULTS[@]}"; do
  IFS='|' read -r name eng nat bld <<<"$row"
  color="$c_off"
  case "$bld" in PASS*) color="$c_green";; FAIL*) color="$c_red"; fails=$((fails+1));; esac
  printf '%-20s %-16s %-28s %s%s%s\n' "$name" "$eng" "$nat" "$color" "$bld" "$c_off"
done

echo
if [ "$DO_BUILD" -eq 0 ]; then
  warn "static audit only — re-run with --fetch-node22 (or --node22 <path>) to build-test."
elif [ "$fails" -eq 0 ]; then
  log "all build tests passed under Node 22. Native deps (if any) still need 'npm rebuild' post-bump."
else
  warn "$fails site(s) failed to build under Node 22 — inspect the /tmp/n22-<site>.log files before bumping."
fi
