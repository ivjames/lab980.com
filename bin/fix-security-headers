#!/usr/bin/env bash
# lab980-fix-security-headers — give every vhost the standard security
# response headers, from one shared snippet.
#
# Why: the QA engine's security pipeline flags every site that omits them
# (missing-hsts / missing-xcto / missing-frame-protection /
# missing-referrer-policy / missing-permissions-policy / missing-csp /
# server-version-disclosure). nginx serves static files and proxies apps per
# vhost, so the one place that reliably covers BOTH static assets and app
# responses is the vhost itself — not each app.
#
# What this manages:
#   /etc/nginx/snippets/lab980-security-headers.conf   five safe-everywhere
#       headers: HSTS, X-Content-Type-Options, X-Frame-Options,
#       Referrer-Policy, Permissions-Policy. Included at server{} level in
#       every :443 ssl server block.
#   /etc/nginx/snippets/lab980-csp-self.conf           a strict self-only
#       Content-Security-Policy. NOT safe everywhere (breaks sites that use
#       inline scripts, CDNs, or external APIs like Supabase), so it is
#       opt-in per host via --csp <fqdn> (repeatable).
#   /etc/nginx/conf.d/lab980-server-tokens.conf        server_tokens off;
#       (http-level) so the Server header stops disclosing the nginx version.
#
# Modes, matching the other lab980 fixers:
#   audit (default)  read-only: per-vhost matrix of which headers are covered
#   --dry-run        show the unified diff of what --fix would change
#   --fix            write snippets + conf.d, insert includes, nginx -t,
#                    roll back from backup if the test fails, reload
#
# nginx add_header gotcha: server-level add_header is inherited by a
# location{} only if that location sets NO add_header of its own. Our
# provision-site vhosts don't add headers inside locations, so the snippet
# include at server level covers everything. A vhost that already sets its
# own Strict-Transport-Security is left alone (assumed hand-tuned).
set -euo pipefail

ENABLED_DIR="/etc/nginx/sites-enabled"
SNIPPET_DIR="/etc/nginx/snippets"
BASE_SNIPPET="$SNIPPET_DIR/lab980-security-headers.conf"
CSP_SNIPPET="$SNIPPET_DIR/lab980-csp-self.conf"
TOKENS_CONF="/etc/nginx/conf.d/lab980-server-tokens.conf"
BACKUP_ROOT="/var/backups"
MODE="audit"
CSP_HOSTS=()

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
lab980-fix-security-headers — standard security response headers for every
vhost via one shared snippet, plus server_tokens off.

Usage:
  fix-security-headers                       audit: per-vhost header matrix
  fix-security-headers --dry-run [--csp ..]  show the diff --fix would apply
  fix-security-headers --fix [--csp <fqdn>]  apply: snippets + includes,
                                             nginx -t, reload (rollback on
                                             a failed test)

Options:
  --csp <fqdn>   ALSO include the strict self-only Content-Security-Policy
                 snippet in the vhost(s) whose server_name mentions <fqdn>.
                 Repeatable. Opt-in because a self-only CSP breaks sites
                 that load anything cross-origin or inline.
  -h, --help     this help

Headers in the shared snippet (safe on every site here):
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options:    nosniff
  X-Frame-Options:           SAMEORIGIN
  Referrer-Policy:           strict-origin-when-cross-origin
  Permissions-Policy:        camera=(), microphone=(), geolocation=()

Idempotent — vhosts that already have the include (or their own
Strict-Transport-Security header) are left untouched. Re-run any time,
e.g. after provisioning a site with an older provision-site.
USAGE
}

# ---- parse args ----
while [ $# -gt 0 ]; do
  case "$1" in
    --fix)     MODE="fix"; shift;;
    --dry-run) MODE="dry-run"; shift;;
    --csp)     [ $# -ge 2 ] || die "--csp needs a fqdn"; CSP_HOSTS+=("$2"); shift 2;;
    -h|--help) usage; exit 0;;
    -*) die "unknown option: $1 (see --help)";;
    *)  die "unexpected arg: $1";;
  esac
done

[ -d "$ENABLED_DIR" ] || die "$ENABLED_DIR not found — is nginx installed?"
if [ "$MODE" = "fix" ]; then
  [ "$(id -u)" -eq 0 ] || die "run as root for --fix."
fi

base_snippet_body() {
  cat <<'EOF'
# lab980 shared security headers — managed by fix-security-headers.
# Included at server{} level by every :443 vhost. Do not add a CSP here:
# that one is per-site (snippets/lab980-csp-self.conf, opt-in).
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
EOF
}

csp_snippet_body() {
  cat <<'EOF'
# lab980 strict self-only CSP — managed by fix-security-headers, OPT-IN per
# vhost (fix-security-headers --fix --csp <fqdn>). Only for sites that load
# every script/style/image/fetch from their own origin.
add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
EOF
}

# ---- collect enabled vhost files (dedupe symlink targets) ----
files=()
for link in "$ENABLED_DIR"/*; do
  [ -e "$link" ] || continue
  real="$(readlink -f "$link")"
  dup=0
  for f in ${files[@]+"${files[@]}"}; do [ "$f" = "$real" ] && { dup=1; break; }; done
  [ "$dup" -eq 0 ] && files+=("$real")
done
[ "${#files[@]}" -gt 0 ] || die "no enabled sites under $ENABLED_DIR."

# A vhost participates only if it has an ssl :443 listen (plain :80-only
# vhosts are pre-certbot stubs; provision-site now bakes the include in).
has_ssl_443() { grep -qE '^[[:space:]]*listen[[:space:]][^;]*443[^;]*ssl' "$1"; }

wants_csp() { # $1 = vhost file — true if any --csp fqdn appears in a server_name
  local f="$1" h
  for h in ${CSP_HOSTS[@]+"${CSP_HOSTS[@]}"}; do
    grep -qE "^[[:space:]]*server_name[^;]*[[:space:]]$h([[:space:];]|$)" "$f" && return 0
  done
  return 1
}

# ---- audit ----
log "Scanning ${#files[@]} enabled vhost file(s)"
printf '%-52s %-5s %-5s %-5s %-5s %-5s %-4s\n' "vhost" "hsts" "xcto" "xfo" "refer" "perms" "csp"
covered=0; uncovered=0
for f in "${files[@]}"; do
  has_ssl_443 "$f" || { printf '%-52s (no :443 ssl block — skipped)\n' "$(basename "$f")"; continue; }
  inc=0; grep -q "lab980-security-headers.conf" "$f" && inc=1
  cinc=0; grep -q "lab980-csp-self.conf" "$f" && cinc=1
  y() { { [ "$inc" -eq 1 ] || grep -qi "add_header[[:space:]]*$1" "$f"; } && echo yes || echo NO; }
  csp_state="NO"
  { [ "$cinc" -eq 1 ] || grep -qi "add_header[[:space:]]*Content-Security-Policy" "$f"; } && csp_state="yes"
  printf '%-52s %-5s %-5s %-5s %-5s %-5s %-4s\n' "$(basename "$f")" \
    "$(y Strict-Transport-Security)" "$(y X-Content-Type-Options)" \
    "$(y X-Frame-Options)" "$(y Referrer-Policy)" "$(y Permissions-Policy)" "$csp_state"
  if [ "$inc" -eq 1 ] || grep -qi "add_header[[:space:]]*Strict-Transport-Security" "$f"; then
    covered=$(( covered + 1 ))
  else
    uncovered=$(( uncovered + 1 ))
  fi
done
echo
tokens_state="MISSING"
grep -qrE '^[[:space:]]*server_tokens[[:space:]]+off' /etc/nginx/nginx.conf /etc/nginx/conf.d 2>/dev/null && tokens_state="off (good)"
log "server_tokens: $tokens_state | vhosts covered: $covered | uncovered: $uncovered"
[ "$MODE" = "audit" ] && exit 0

# Insert an include line right after each ssl :443 listen line of a server
# block (first listen of the block only). stdin -> stdout.
add_include() { # $1 = include path relative to /etc/nginx
  awk -v inc="$1" '
    /^[[:space:]]*server[[:space:]]*\{/ { done = 0 }
    { print }
    /^[[:space:]]*listen[[:space:]]/ && /443/ && /[[:space:]]ssl/ {
      if (!done) { print "    include " inc ";"; done = 1 }
    }
  '
}

transform() { # $1 = vhost file, stdin ignored -> transformed content on stdout
  local f="$1" out
  out="$(cat "$f")"
  if has_ssl_443 "$f" \
     && ! grep -q "lab980-security-headers.conf" "$f" \
     && ! grep -qi "add_header[[:space:]]*Strict-Transport-Security" "$f"; then
    out="$(printf '%s\n' "$out" | add_include "snippets/lab980-security-headers.conf")"
  fi
  if wants_csp "$f" \
     && ! grep -q "lab980-csp-self.conf" "$f" \
     && ! grep -qi "add_header[[:space:]]*Content-Security-Policy" "$f"; then
    out="$(printf '%s\n' "$out" | add_include "snippets/lab980-csp-self.conf")"
  fi
  printf '%s\n' "$out"
}

# ---- dry run: snippets + diffs ----
if [ "$MODE" = "dry-run" ]; then
  [ -f "$BASE_SNIPPET" ] || { log "would create $BASE_SNIPPET:"; base_snippet_body | sed 's/^/    /'; }
  if [ "${#CSP_HOSTS[@]}" -gt 0 ] && [ ! -f "$CSP_SNIPPET" ]; then
    log "would create $CSP_SNIPPET:"; csp_snippet_body | sed 's/^/    /'
  fi
  [ -f "$TOKENS_CONF" ] || log "would create $TOKENS_CONF: server_tokens off;"
  changed=0
  for f in "${files[@]}"; do
    if ! transform "$f" | diff -u --label "$f (current)" --label "$f (fixed)" "$f" - ; then
      changed=$(( changed + 1 ))
      echo
    fi
  done
  log "dry run: $changed vhost file(s) would change. Apply with --fix."
  exit 0
fi

# ---- fix: snippets, conf.d, includes; backup, test, reload, rollback ----
stamp="$(date +%Y%m%d-%H%M%S)"
backup_dir="$BACKUP_ROOT/lab980-security-headers-$stamp"
touched=()

backup_then_write() { # $1 = dest file, stdin = new content
  local dest="$1" tmp
  tmp="$(mktemp)"; cat > "$tmp"
  if [ -f "$dest" ] && cmp -s "$dest" "$tmp"; then rm -f "$tmp"; return 0; fi
  if [ -f "$dest" ]; then
    mkdir -p "$backup_dir$(dirname "$dest")"
    cp -p "$dest" "$backup_dir$dest"
  fi
  mkdir -p "$(dirname "$dest")"
  cat "$tmp" > "$dest"
  rm -f "$tmp"
  touched+=("$dest")
  log "wrote $dest"
}

base_snippet_body | backup_then_write "$BASE_SNIPPET"
if [ "${#CSP_HOSTS[@]}" -gt 0 ]; then
  csp_snippet_body | backup_then_write "$CSP_SNIPPET"
fi
printf '# managed by lab980 fix-security-headers\nserver_tokens off;\n' | backup_then_write "$TOKENS_CONF"

for f in "${files[@]}"; do
  tmp="$(mktemp)"
  transform "$f" > "$tmp"
  if cmp -s "$f" "$tmp"; then rm -f "$tmp"; continue; fi
  mkdir -p "$backup_dir$(dirname "$f")"
  cp -p "$f" "$backup_dir$f"
  # overwrite in place (cat > keeps the inode, so sites-enabled symlinks and
  # file ownership/permissions are untouched)
  cat "$tmp" > "$f"
  rm -f "$tmp"
  touched+=("$f")
  log "rewrote $f"
done

if [ "${#touched[@]}" -eq 0 ]; then
  log "nothing to change — everything already covered."
  exit 0
fi
log "backups: $backup_dir"

if ! nginx -t; then
  warn "nginx -t FAILED — rolling back ${#touched[@]} file(s)."
  for f in "${touched[@]}"; do
    if [ -f "$backup_dir$f" ]; then cat "$backup_dir$f" > "$f"; else rm -f "$f"; fi
  done
  nginx -t || warn "nginx -t still failing after rollback — inspect manually!"
  die "aborted; original configs restored from $backup_dir."
fi

systemctl reload nginx
log "Done. ${#touched[@]} file(s) written, nginx reloaded."
log "Verify:  curl -sI https://<site>/ | grep -iE 'strict-trans|x-content|x-frame|referrer|permissions|security-policy|server'"
